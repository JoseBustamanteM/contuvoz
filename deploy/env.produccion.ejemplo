# Plantilla del .env del backend EN LA VPS. Copiar a /opt/contuvoz/server-nest/.env
# y reemplazar lo que está entre < >. No subir el .env real a git.

# Usuario propio de la base (no root), creado en el paso 4 de DEPLOY.md.
DATABASE_URL="mysql://contuvoz:<CLAVE_DE_LA_BASE>@localhost:3306/contuvoz"

# Generar uno nuevo en la VPS con:  openssl rand -hex 32
# No reutilizar el de desarrollo.
JWT_SECRET="<SECRETO_LARGO_Y_ALEATORIO>"

# production: la cookie de sesión se marca Secure (solo viaja por HTTPS,
# que lo pone el túnel de Cloudflare).
NODE_ENV=production

# Solo accesible a través de Nginx, nunca directo desde internet.
HOST=127.0.0.1
PORT=4000

# Frontend y backend comparten dirección, así que CORS no interviene.
FRONTEND_URL="http://localhost"

ACCESS_TOKEN_EXPIRA=15m
REFRESH_TOKEN_DIAS=7
ZONA_HORARIA=America/Santiago
